filters:
  or:
    - file.inFolder("log/books")
    - file.inFolder("log/films")
    - file.inFolder("log/youtube")
    - file.inFolder("log/exercise")
views:
  - type: table
    name: All
    filters:
      and:
        - "file.name != 'index'"
    order:
      - file.name
      - type
      - status
      - created
    sort:
      - property: created
        direction: DESC
